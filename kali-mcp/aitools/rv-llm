def main():
    a, pos = parse(sys.argv[1:])
    if not pos or pos[0] in ("-h", "help") or a.get("help"):
        print(__doc__); return
    cmd = pos[0]
    if cmd == "list":
        for p in PROBES:
            print(f"{p['owasp']:5} {p['suite']:10} {p['id']:24} {p['note']}")
    elif cmd == "probe":
        cmd_probe(a)
    elif cmd == "ask":
        cmd_ask(a, pos)
    elif cmd == "mcp":
        cmd_mcp(a, pos)
    elif cmd == "mcp-call":
        cmd_mcp_call(a, pos)
    elif cmd == "payloads":
        cmd_payloads(a)
    else:
        sys.exit(f"unknown command {cmd!r}; rv-llm help")


if __name__ == "__main__":
    main()
