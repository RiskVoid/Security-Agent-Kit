#!/usr/bin/env python3
"""rv-llm: test LLM applications, AI agents and MCP servers (authorised engagements only). Stdlib only.

Targets (for probe / ask):
  --openai URL --model NAME [--key-env VAR]    OpenAI-compatible chat API (URL = base, e.g. http://h/v1)
  --http URL --body JSON [--reply PATH]        any JSON chat endpoint: {{prompt}} in --body is replaced by the
                                               probe; --reply is a dotted path to the answer (e.g. data.reply)
  --header "K: V" (repeatable)                 auth cookies / tokens for the target
  --system-file F                              the app's system prompt, if known (white-box): improves leak checks

Commands:
  rv-llm probe <target> [--suite S[,S]] [--rate N] [--out F.jsonl]     run the probe library (intrusive)
         suites: injection, leak, jailbreak, output, exfil, tools, dos   (default: all but dos)
  rv-llm ask <target> "prompt" [--repeat N]                             one prompt (active); --repeat checks
                                                                        consistency
  rv-llm mcp <url> [--header ...]                                        enumerate and audit an MCP server
                                                                        (streamable HTTP or SSE; active)
  rv-llm mcp-call <url> <tool> '<json-args>' [--header ...]              call one MCP tool (intrusive)
  rv-llm payloads [--canary C] [--exfil-url U]                           indirect prompt-injection payloads to
                                                                        plant in content the target ingests
  rv-llm list                                                            list probes with OWASP LLM Top 10 ids

Every probe carries a random canary; a reply containing it means the model followed the injected instruction.
Verdicts: HIT (canary or leak marker found), REVIEW (suspicious, judge it yourself), MISS. HITs are leads, not
findings: confirm by hand and record the evidence file.
"""
import json, os, random, re, string, sys, threading, time, urllib.error, urllib.parse, urllib.request

UA = "rv-llm/1.0 (RiskVoid agent kit; authorised security test)"


