# Created by ./rvkit setup. Do not share your .env.

# --- Folders ---------------------------------------------------------------------------------------------------
# Client code (mounted read-only as /src) and engagements (mounted as /work). ./rvkit setup asks for the parent
# folder (default ~/riskvoid). Change both here, then run ./rvkit up.
PROJECTS_DIR=~/riskvoid/projects
ENGAGEMENTS_DIR=~/riskvoid/engagements

# --- Secrets (generated by ./rvkit setup) ----------------------------------------------------------------------
LITELLM_MASTER_KEY=change-me
SEARXNG_SECRET=change-me
# Key the Colab notebook protects its endpoint with, and the last Colab URL and model
COLAB_API_KEY=change-me
COLAB_API_BASE=
# OpenHands local API key (lets ./rvkit configure OpenHands)
OPENHANDS_API_KEY=change-me
# REDIS_PASSWORD (spend counter store) is generated by ./rvkit

# --- Worker model (runs the tools, sees client code) -----------------------------------------------------------
# OpenAI-compatible endpoint. Set with ./rvkit connect / ./rvkit worker, not by hand.
WORKER_API_BASE=http://worker-not-connected.invalid/v1
WORKER_API_KEY=change-me
WORKER_MODEL_ID=openai/qwen38-27b-obl
# Fallback while the worker endpoint is down: OFF by default, because the fallback model (OpenRouter,
# zero-data-retention providers) then sees tool output and client code. ./rvkit worker fallback on|off|<model>
WORKER_FALLBACK=off
WORKER_FALLBACK_MODEL=openrouter/deepseek/deepseek-v4.1-flash
# Characters of task context the worker keeps (~25K tokens; fits a 32K-context model). Raise it for a model with a
# longer context, then ./rvkit up
# WORKER_CONTEXT_CHARS=90000
# Tasks the worker runs at once. Keep 1 for Colab (one request at a time); raise for an API or a local server
# started with parallel slots
# WORKER_PARALLEL_TASKS=1

# --- Planner model (OpenRouter, or Anthropic / OpenAI directly) ------------------------------------------------
# Key from https://openrouter.ai/keys. ./rvkit setup asks for it (hidden input); or set it here, then ./rvkit up.
OPENROUTER_API_KEY=
# OpenRouter model ids, zero-data-retention providers: ./rvkit planner <model> [fallback-model]
PLANNER_MODEL=openrouter/anthropic/claude-sonnet-5.5
PLANNER_FALLBACK_MODEL=openrouter/openai/gpt-6.1-sol
# Or use Anthropic / OpenAI directly (no OpenRouter): ./rvkit planner --direct anthropic/<model> [fallback]
# asks for the key. Direct calls follow that provider's own API data terms, not OpenRouter's zero-data-retention routing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Daily spend cap in USD, per provider (OpenRouter: planner, plus the worker fallback when on; Anthropic / OpenAI
# when used directly): ./rvkit budget <usd>
OPENROUTER_DAILY_BUDGET=20

# --- Reports and branding --------------------------------------------------------------------------------------
# riskvoid (default), plain (neutral, no logo) or custom (your logo and colours from REPORT_BRAND_FOLDER; see
# harness/brands/example/README.md). Run ./rvkit up after changing these.
REPORT_BRAND=riskvoid
# Your organisation's name, used on reports and in the planner's persona (empty = RiskVoid / "the security team")
ORG_NAME=
# REPORT_BRAND_FOLDER=/path/to/your/brand

# --- Network ---------------------------------------------------------------------------------------------------
# The OpenHands agent has no direct internet. It reaches package registries and vulnerability databases through
# an allowlisting proxy (egress/allowlist.txt). Extra domains, comma-separated (subdomains included):
EGRESS_EXTRA_DOMAINS=
# Ports published on 127.0.0.1. Change one if another app already uses it, then ./rvkit up
# GATEWAY_PORT=8000     # the UI
# LITELLM_PORT=4000     # model gateway
# SEARXNG_PORT=8888     # search
# CONSOLE_PORT=8100     # ./rvkit console (runs on the host, not in Docker)

# --- Optional --------------------------------------------------------------------------------------------------
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key) for faster CVE lookups
NVD_API_KEY=
# Image versions are pinned in docker-compose.yml; override here only to test a newer release
# AGENT_CANVAS_TAG=
# LITELLM_TAG=
# SEARXNG_TAG=
# RVKIT_REGISTRY=ghcr.io/riskvoid/security-agent-kit   # where ./rvkit pulls the kit's own images from
