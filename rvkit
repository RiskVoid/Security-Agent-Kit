# ---------------------------------------------------------------- worker
detect_local() { # prints "<port> <model>" of the first local OpenAI-compatible server found
  local p m
  for p in 11434 1234 8080 8001 5000; do
    m="$(curl -s -m 2 "http://127.0.0.1:$p/v1/models" 2>/dev/null | python3 -c 'import sys,json
try: print(json.load(sys.stdin)["data"][0]["id"])
except Exception: pass' 2>/dev/null || true)"
    [ -n "$m" ] && { echo "$p $m"; return 0; }
  done
  return 1
}

cmd_worker() {
  need_env
  case "${1:-show}" in
    show)
      echo "worker endpoint: $(envget WORKER_API_BASE)   model: $(envget WORKER_MODEL_ID)"
      case "$(envget WORKER_MODEL_ID)" in openrouter/*)
        echo "  hosted on OpenRouter (zero-data-retention providers): tool output and client code go there, also for"
        echo "  'Worker model: private' engagements and the riskvoid-local agent. For fully local work: ./rvkit worker local" ;; esac
      if [ "$(envget WORKER_FALLBACK)" = "on" ]; then
        echo "fallback (when the endpoint is down): $(envget WORKER_FALLBACK_MODEL) via OpenRouter, zero-data-retention providers"
        echo "  while it is in use, tool output and client code go to that model"
      else echo "fallback: off (worker calls fail while the endpoint is down; ./rvkit worker fallback on allows it)"; fi
      return 0 ;;
    fallback)
      case "${2:-show}" in
        show) cmd_worker show; return 0 ;;
        off)  envset WORKER_FALLBACK off ;;
        on)   envset WORKER_FALLBACK on ;;
        *)    envset WORKER_FALLBACK_MODEL "openrouter/${2#openrouter/}"; envset WORKER_FALLBACK on ;;
      esac
      recreate_litellm; cmd_worker show; return 0 ;;
    colab)
      [ -n "$(envget COLAB_API_BASE)" ] || die "No Colab URL yet: start the model (/rv-start), then ./rvkit connect <url>"
      envset WORKER_API_BASE "$(envget COLAB_API_BASE)"; envset WORKER_API_KEY "$(envget COLAB_API_KEY)"
      envset WORKER_MODEL_ID "openai/$(envget COLAB_MODEL || true)"
      [ "$(envget WORKER_MODEL_ID)" != "openai/" ] || envset WORKER_MODEL_ID "openai/qwen38-27b-obl" ;;
    local) # llama-server / LM Studio / Ollama / vLLM on this machine
      local url="${2:-}" model="${3:-}" found
      if [ -z "$url" ]; then
        found="$(detect_local)" || die "No local model server found on ports 11434 (Ollama), 1234 (LM Studio), 8080 (llama-server), 8001/5000. Start one, or: ./rvkit worker local <url/v1> <model>"
        url="http://host.docker.internal:${found%% *}/v1"; model="${model:-${found#* }}"
        ok "found $model on port ${found%% *}"
        [ "$(uname)" = Linux ] && echo "   ${D}Linux: the server must listen on 0.0.0.0 or the Docker bridge (Ollama: OLLAMA_HOST=0.0.0.0), not only 127.0.0.1${N}"
      fi
      envset WORKER_API_BASE "$url"; envset WORKER_API_KEY "${4:-none}"
      envset WORKER_MODEL_ID "openai/${model:-local}" ;;
    api)   # any OpenAI-compatible endpoint with a fixed URL: RunPod, Modal, a GPU server, vLLM, ...
      [ $# -ge 3 ] || die "usage: ./rvkit worker api <base-url/v1> <model-name> [api-key]"
      envset WORKER_API_BASE "$2"; envset WORKER_API_KEY "${4:-none}"; envset WORKER_MODEL_ID "openai/$3" ;;
    openrouter) # no GPU at all: a hosted model through the OpenRouter key (zero-data-retention providers)
      [ -n "$(envget OPENROUTER_API_KEY)" ] || die "needs OPENROUTER_API_KEY in .env (https://openrouter.ai/keys), then ./rvkit up"
      local m="${2:-$(envget WORKER_FALLBACK_MODEL)}"; m="${m#openrouter/}"
      warn "Tool output and client code will go to $m on OpenRouter (zero-data-retention providers only)."
      envset WORKER_API_BASE "https://openrouter.ai/api/v1"; envset WORKER_API_KEY none
      envset WORKER_MODEL_ID "openrouter/${m:-deepseek/deepseek-v4.1-flash}" ;;
    *) die "usage: ./rvkit worker [show | colab | local [url] [model] [key] | api <url> <model> [key] | openrouter [model] | fallback [on|off|<openrouter-model>]]" ;;
  esac
  recreate_litellm; ok "Worker: $(envget WORKER_API_BASE) ($(envget WORKER_MODEL_ID))"; test_model
}

# ---------------------------------------------------------------- install / completion
COMMANDS="setup up down update console status doctor logs connect worker planner budget test key openhands new engagement eng quickstart watch scope show approvals approve deny halt resume audit report close delete lab bench install completion help"
ENG_SUB="list new show scope approvals approve deny halt resume audit report close delete"
cmd_install() {
  local dir="${1:-$HOME/.local/bin}"
  mkdir -p "$dir"; ln -sf "$SELF" "$dir/rvkit"; ok "linked $dir/rvkit → $SELF"
  case ":$PATH:" in *":$dir:"*) ;; *) warn "$dir is not on your PATH: add it in your shell profile" ;; esac
  echo "Shell completion:"
  echo "   bash: echo 'eval \"\$(rvkit completion bash)\"' >> ~/.bashrc"
  echo "   zsh:  echo 'eval \"\$(rvkit completion zsh)\"' >> ~/.zshrc"
  echo "   fish: rvkit completion fish > ~/.config/fish/completions/rvkit.fish"
}
cmd_completion() {
  case "${1:-}" in
    bash|zsh)
      [ "$1" = zsh ] && echo "autoload -U +X bashcompinit && bashcompinit"
      cat <<EOF
_rvkit() {
  local cur="\${COMP_WORDS[COMP_CWORD]}" prev="\${COMP_WORDS[COMP_CWORD-1]}" engs
  if [ "\$COMP_CWORD" -eq 1 ]; then COMPREPLY=( \$(compgen -W "$COMMANDS" -- "\$cur") ); return; fi
  case "\$prev" in
    eng) COMPREPLY=( \$(compgen -W "$ENG_SUB" -- "\$cur") ) ;;
    worker) COMPREPLY=( \$(compgen -W "show colab local api openrouter fallback" -- "\$cur") ) ;;
    lab) COMPREPLY=( \$(compgen -W "up down status" -- "\$cur") ) ;;
    show|scope|approvals|approve|deny|halt|resume|audit|report|close|delete)
      engs="\$(ls "\$(grep -E '^ENGAGEMENTS_DIR=' "$KIT/.env" 2>/dev/null | cut -d= -f2- | sed "s|^~|\$HOME|")" 2>/dev/null | grep -v '^_')"
      COMPREPLY=( \$(compgen -W "\$engs" -- "\$cur") ) ;;
  esac
}
complete -F _rvkit rvkit
EOF
      ;;
    fish)
      echo "complete -c rvkit -f"
      echo "complete -c rvkit -n '__fish_use_subcommand' -a '$COMMANDS'"
      echo "complete -c rvkit -n '__fish_seen_subcommand_from eng' -a '$ENG_SUB'"
      echo "complete -c rvkit -n '__fish_seen_subcommand_from worker' -a 'show colab local api openrouter fallback'"
      echo "complete -c rvkit -n '__fish_seen_subcommand_from lab' -a 'up down status'"
      echo "complete -c rvkit -n '__fish_seen_subcommand_from show scope approvals approve deny halt resume audit report close delete' -a \"(ls (grep -E '^ENGAGEMENTS_DIR=' $KIT/.env | cut -d= -f2- | string replace -r '^~' \$HOME) 2>/dev/null | string match -v '_*')\""
      ;;
    *) die "usage: ./rvkit completion bash|zsh|fish" ;;
  esac
}

# ops <operation> <request-json>: one harness/ops.py operation in findings-mcp; a change is added to the audit log.
ops() {
  local out rc=0
  out="$(printf '%s' "$2" | docker compose exec -T findings-mcp python3 ops.py "$1")" || rc=$?
  python3 -c 'import json,sys; d=json.loads(sys.argv[1].strip().splitlines()[-1]); sys.exit(0 if "error" not in d else print("error: " + d["error"], file=sys.stderr) or 1)' "$out" || return 1
  local ev; ev="$(python3 -c 'import json,sys; e=json.loads(sys.argv[1].strip().splitlines()[-1]).get("event"); print(json.dumps(e) if e else "")' "$out")"
  if [ -n "$ev" ]; then printf '%s' "$ev" | kctl record "$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["engagement"])' "$2")" >/dev/null \
    || warn "the change was saved but not added to the audit log"; fi
  printf '%s\n' "$out" | tail -1
  return $rc
}

cmd_finding() { # finding <eng> <F-id> key=value...
  [ $# -ge 3 ] || die "usage: ./rvkit finding <engagement> <F-001> status=confirmed [severity=high] [notes=\"...\"]"
  local req
  req="$(python3 -c '
import json, sys
eng, fid, actor, pairs = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
fields = {}
for p in pairs:
    if "=" not in p:
        sys.exit(f"expected key=value, got {p!r}")
    k, v = p.split("=", 1)
    fields[k.strip()] = v
print(json.dumps({"engagement": eng, "actor": actor, "id": fid, "fields": fields}))' "$1" "$2" "$(actor)" "${@:3}")" || die "bad arguments"
  local out; out="$(ops finding.update "$req")" || exit 1
  printf '%s' "$out" | python3 -c 'import json,sys; f=json.loads(sys.stdin.read())["result"]; print("%s: %s, %s (revision %s) %s" % (f["id"], f["status"], f["severity"], f["revision"], f["title"]))'
}

