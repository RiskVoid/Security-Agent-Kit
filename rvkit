# ---------------------------------------------------------------- dispatch
cmd="${1:-help}"; shift || true
if [ "$cmd" = eng ]; then # rvkit eng <sub> …  ==  rvkit <sub> …  (list is eng-only)
  cmd="${1:-list}"; shift || true
  case " $ENG_SUB " in *" $cmd "*) ;; *) die "usage: ./rvkit eng [$ENG_SUB]" ;; esac
  [ "$cmd" = list ] && cmd=englist
fi
case "$cmd" in
  setup|init) cmd_setup "$@" ;;
  doctor)     need_env; cmd_doctor "$@" ;;
  up)         need_env; need_docker; start_stack; wait_litellm
              config_openhands --quiet; ok "Stack is up: $UI_URL" ;;
  down)       need_env; docker compose down; ok "Stack stopped (your settings are kept)" ;;
  update)     cmd_update ;;
  console)    need_env; need_docker
              bold "RiskVoid Console: engagements, approvals, findings, reports"
              kit_exposed && die "The kit folder is inside PROJECTS_DIR or ENGAGEMENTS_DIR, so containers could read .env and the console token. Move the kit or change those settings first."
              echo "   Runs on this computer only (127.0.0.1) and needs its sign-in token, which no container has. Ctrl-C stops it."
              if [ "${1:-}" = "--no-open" ]; then echo "   Sign-in link: $(python3 scripts/console.py --print-url-only)"; exec python3 scripts/console.py
              else exec python3 scripts/console.py --open; fi ;;
  status)     need_env; need_docker; cmd_status ;;
  logs)       need_env  # (bash 3.2 turns "${@:-}" into one empty argument, which docker compose rejects)
              if [ $# -gt 0 ]; then docker compose logs --tail 80 "$@"; else docker compose logs --tail 80; fi ;;
  connect)
    need_env
    [ $# -ge 1 ] || die "usage: ./rvkit connect <url/v1> [key] [model]"
    url="$1"; case "$url" in */v1) ;; *) url="${url%/}/v1" ;; esac
    envset COLAB_API_BASE "$url"
    [ $# -ge 2 ] && [ -n "$2" ] && envset COLAB_API_KEY "$2"
    envset COLAB_MODEL "${3:-qwen38-27b-obl}"
    envset WORKER_API_BASE "$url"; envset WORKER_API_KEY "$(envget COLAB_API_KEY)"
    envset WORKER_MODEL_ID "openai/$(envget COLAB_MODEL)"
    recreate_litellm
    ok "Worker now points at Colab: $url ($(envget COLAB_MODEL))"
    test_model ;;
  worker)     cmd_worker "$@" ;;
  budget)
    need_env
    if [ $# -eq 0 ]; then
      echo "Daily budget: \$$(envget OPENROUTER_DAILY_BUDGET) per provider (OpenRouter; Anthropic / OpenAI when the planner uses them directly)"
      curl -s -m 10 $LITELLM_URL/provider/budgets -H "Authorization: Bearer $(envget LITELLM_MASTER_KEY)" |
        python3 -c 'import sys,json
try: p=json.load(sys.stdin)["providers"]
except Exception: sys.exit()
for k, b in p.items(): print("%s: spent $%.4f in the current 24 h period" % (k, b.get("spend") or 0))' || true
      exit 0
    fi
    [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "usage: ./rvkit budget <usd-per-day>"
    envset OPENROUTER_DAILY_BUDGET "$1"
    recreate_litellm; ok "OpenRouter budget: \$$1 per day (spend so far is kept)" ;;
  planner)
    need_env
    case "${1:-show}" in
      show) echo "planner: $(envget PLANNER_MODEL)   fallback: $(envget PLANNER_FALLBACK_MODEL)"
            echo "   openrouter/...: zero-data-retention providers only. anthropic/... or openai/...: that provider's API directly, under its own data terms"
            exit 0 ;;
      --direct)
            shift; [ $# -ge 1 ] || die "usage: ./rvkit planner --direct anthropic/<model>|openai/<model> [fallback]"
            for m in "$@"; do
              [[ "$m" =~ ^(anthropic|openai|openrouter)/[A-Za-z0-9._:/-]+$ ]] || die "model ids must start with anthropic/, openai/ or openrouter/: $m"
              k="$(planner_key "$m")"
              if [ -z "$(envget "$k")" ]; then
                key="$(ask_secret "$k for $m (hidden input)")"
                [ -n "$key" ] || die "$k is needed for $m"; envset "$k" "$key"
              fi
            done
            envset PLANNER_MODEL "$1"; [ $# -ge 2 ] && envset PLANNER_FALLBACK_MODEL "$2"
            recreate_litellm; "$SELF" planner show; test_model planner ;;
      *)    envset PLANNER_MODEL "openrouter/${1#openrouter/}"
            [ $# -ge 2 ] && envset PLANNER_FALLBACK_MODEL "openrouter/${2#openrouter/}"
            recreate_litellm; "$SELF" planner show; test_model planner ;;
    esac ;;
  test)       need_env; test_model "${1:-colab-qwen}" ;;
  key)
    need_env
    case "${1:-colab}" in
      colab)     envget COLAB_API_KEY ;;
      litellm)   envget LITELLM_MASTER_KEY ;;
      openhands) envget OPENHANDS_API_KEY ;;
      *) die "usage: ./rvkit key [colab|litellm|openhands]" ;;
    esac ;;
  openhands)  need_env; bold "Configuring OpenHands"; config_openhands && ok "OpenHands ready: $UI_URL (agent: riskvoid-planner)" ;;
  new)        cmd_new "$@" ;;
  engagement) cmd_engagement "$@" ;;
  englist)    need_env; kctl list ;;
  quickstart) cmd_quickstart ;;
  watch)      need_env; cmd_watch ;;
  scope)
    need_env; [ $# -ge 1 ] || die "usage: ./rvkit scope <engagement> [--yes]   (apply edits to SCOPE.md / RULES.md)"
    kctl sync "$@" || true ;;
  show)       need_env; [ $# -ge 1 ] || die "usage: ./rvkit show <engagement>"; kctl show "$1" ;;
  approvals)  need_env; kctl approvals "$@" ;;
  approve|deny)
    need_env; [ $# -ge 2 ] || die "usage: ./rvkit $cmd <engagement> <approval-id>"; kctl "$cmd" "$1" "$2" ;;
  halt|resume)
    need_env; [ $# -ge 1 ] || die "usage: ./rvkit $cmd <engagement>"; kctl "$cmd" "$1" ;;
  audit)      need_env; kctl audit "$@" ;;
  lab)
    need_env
    case "${1:-status}" in
      up)
        docker compose --profile lab up -d ${RVKIT_BUILD:+--build} $LAB   # builds lab-llm only when missing (RVKIT_BUILD=1: rebuild)
        lab_dvwa_init; lab_vampi_init
        ok "Lab up (isolated network 10.250.0.0/24, reachable only from engagements that have it in scope):"
        echo "   Juice Shop  http://10.250.0.10:3000"
        echo "   DVWA        http://10.250.0.11   (admin / password, security level low)"
        echo "   VAmPI       http://10.250.0.13:5000   REST API (OWASP API Top 10), spec at /openapi.json"
        echo "   DVGA        http://10.250.0.14:5013/graphql   GraphQL API"
        echo "   LLM lab     http://10.250.0.15:8000   AI support assistant (chat /api/chat, MCP /mcp)"
        echo "   Try: ./rvkit quickstart, or ./rvkit engagement lab-juice 10.250.0.10" ;;
      down)   docker compose --profile lab stop $LAB >/dev/null 2>&1; docker compose --profile lab rm -f $LAB >/dev/null 2>&1
              ok "Lab stopped and removed (it resets to a clean state on the next 'lab up')" ;;
      status) docker compose --profile lab ps $LAB --format 'table {{.Service}}\t{{.State}}\t{{.Status}}' ;;
      *) die "usage: ./rvkit lab up|down|status" ;;
    esac ;;
  bench)
    need_env; [ $# -ge 1 ] || die "usage: ./rvkit bench <name|all> [--agent riskvoid-planner|riskvoid-local]   (list: ls evals/benchmarks)"
    python3 evals/run_benchmark.py "$@" ;;
  finding)    need_env; cmd_finding "$@" ;;
  report)     need_env; [ $# -ge 1 ] || die "usage: ./rvkit report <engagement>"
              docker compose exec -T findings-mcp python3 report.py "$1" ;;
  close)      need_env; [ $# -ge 1 ] || die "usage: ./rvkit close <engagement>"; kctl close "$1" ;;
  delete)
    need_env; [ $# -ge 1 ] || die "usage: ./rvkit eng delete <engagement> [--force]   (closed engagements; --force for any)"
    case " $* " in *" --force "*) yesno "Delete $1 without closing it (no archive or manifest)? Its folder is kept, renamed" n || die "not deleted" ;; esac
    kctl delete "$@" ;;
  install)    cmd_install "$@" ;;
  completion) cmd_completion "$@" ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; die "unknown command: $cmd" ;;
esac
