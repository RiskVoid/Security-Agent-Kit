#!/usr/bin/env bash
# rvkit: control script for the RiskVoid agent kit. Works from bash, zsh and fish (it runs under bash; macOS bash
# 3.2 compatible). Run ./rvkit help to see the commands.
set -euo pipefail
SELF="$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0")"   # resolves the symlink made by ./rvkit install
KIT="$(cd "$(dirname "$SELF")" && pwd)"
cd "$KIT"

if [ -t 1 ]; then B=$'\033[1m' G=$'\033[32m' Y=$'\033[33m' R=$'\033[31m' D=$'\033[2m' N=$'\033[0m'
else B="" G="" Y="" R="" D="" N=""; fi
bold() { printf '%s%s%s\n' "$B" "$*" "$N"; }
ok()   { printf '%s✔%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
bad()  { printf '%s✘%s %s\n' "$R" "$N" "$*"; }
die()  { printf '%s✘%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

envget() { grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2-; }
GATEWAY_PORT="$(envget GATEWAY_PORT || true)"; GATEWAY_PORT="${GATEWAY_PORT:-8000}"   # published ports (.env)
LITELLM_PORT="$(envget LITELLM_PORT || true)"; LITELLM_PORT="${LITELLM_PORT:-4000}"
UI_URL="http://localhost:$GATEWAY_PORT/"
export OPENHANDS_URL="http://127.0.0.1:$GATEWAY_PORT" LITELLM_URL="http://127.0.0.1:$LITELLM_PORT"
envset() { # portable in-place edit (macOS + Linux); adds the key if missing
  grep -qE "^$1=" .env || { printf '%s=%s\n' "$1" "$2" >> .env; return; }
  K="$1" V="$2" perl -pi -e 's/^\Q$ENV{K}\E=.*/$ENV{K}=$ENV{V}/' .env
}
envensure() { grep -qE "^$1=" .env || printf '%s=%s\n' "$1" "$2" >> .env; }
rand() { openssl rand -hex "$1"; }
expand() { local p="$1"; printf '%s' "${p/#\~/$HOME}"; }

# Interactive prompts read from the terminal; with --yes, RVKIT_YES=1 or no terminal they take the default.
interactive() { [ -z "${RVKIT_YES:-}" ] && [ -t 0 ] && [ -r /dev/tty ]; }
ask() { # ask "Question" "default" -> answer on stdout
  local a=""
  if interactive; then printf '%s%s%s [%s]: ' "$B" "$1" "$N" "$2" > /dev/tty; IFS= read -r a < /dev/tty || true; fi
  printf '%s' "${a:-$2}"
}
ask_secret() { # ask_secret "Question" -> answer on stdout (not echoed)
  local a=""
  if interactive; then printf '%s%s%s (input hidden, Enter to skip): ' "$B" "$1" "$N" > /dev/tty
    IFS= read -r -s a < /dev/tty || true; printf '\n' > /dev/tty; fi
  printf '%s' "$a"
}
yesno() { # yesno "Question" y|n -> exit status
  local a; a="$(ask "$1 (y/n)" "$2")"; case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

need_env() {
  [ -f .env ] || die "No .env yet. Run: ./rvkit setup"
  # migrate older .env files and fill in settings added in newer versions
  envensure WORKER_API_BASE "$(envget COLAB_API_BASE || true)"
  [ -n "$(envget WORKER_API_BASE)" ] || envset WORKER_API_BASE "http://worker-not-connected.invalid/v1"
  envensure WORKER_API_KEY "$(envget COLAB_API_KEY || true)"
  envensure WORKER_MODEL_ID "openai/qwen38-27b-obl"
  envensure WORKER_FALLBACK_MODEL "openrouter/deepseek/deepseek-v4.1-flash"
  envensure WORKER_FALLBACK "off"
  envensure PLANNER_MODEL "openrouter/openai/gpt-6.1-sol"
  envensure PLANNER_FALLBACK_MODEL "openrouter/deepseek/deepseek-v4-pro"
  envensure OPENROUTER_DAILY_BUDGET "20"
  envensure REDIS_PASSWORD "$(rand 24)"
  envensure OPENHANDS_API_KEY "oh-rv-$(rand 24)"
  [ "$(envget OPENHANDS_API_KEY)" != "change-me" ] || envset OPENHANDS_API_KEY "oh-rv-$(rand 24)"
  # old template set AGENT_CANVAS_TAG=latest, which overrides the pinned, tested version
  [ "$(envget AGENT_CANVAS_TAG)" != "latest" ] || perl -ni -e 'print unless /^AGENT_CANVAS_TAG=latest$/' .env
  render_litellm
}
# litellm/config.yaml is a tracked template. The settings users change (budget, worker fallback) live in .env and
# are rendered into .rvkit/litellm.yaml (git-ignored), which is the file the litellm container reads.
render_litellm() {
  mkdir -p .rvkit
  python3 scripts/render_litellm.py || die "could not render the LiteLLM config (see above)"
}
planner_key() { # the .env key the planner model uses: planner_key [model]
  case "${1:-$(envget PLANNER_MODEL)}" in anthropic/*) echo ANTHROPIC_API_KEY ;; openai/*) echo OPENAI_API_KEY ;; *) echo OPENROUTER_API_KEY ;; esac
}
spend_sum() { # today's spend across the providers LiteLLM budgets (OpenRouter, and Anthropic when used directly)
  curl -s -m 5 $LITELLM_URL/provider/budgets -H "Authorization: Bearer $(envget LITELLM_MASTER_KEY)" | python3 -c 'import sys,json
try: print("%.2f" % sum((b.get("spend") or 0) for b in json.load(sys.stdin)["providers"].values()))
except Exception: print("?")' 2>/dev/null || echo "?"
}
recreate_litellm() { render_litellm; docker compose up -d --force-recreate litellm >/dev/null 2>&1; wait_litellm; }
need_docker() {
  command -v docker >/dev/null || die "Docker is not installed. Install Docker Desktop or OrbStack (macOS), or Docker Engine (Linux)."
  docker info >/dev/null 2>&1 || die "Docker is not running. Start Docker and try again."
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is missing ('docker compose'). Update Docker."
}

wait_litellm() {
  for _ in $(seq 1 40); do
    curl -s -o /dev/null $LITELLM_URL/health/liveliness && return 0
    sleep 2
  done
  warn "LiteLLM is not responding yet. Check with: ./rvkit logs litellm"
}

llm() { # llm <model> -> response JSON (one short completion through LiteLLM)
  curl -s -m 180 $LITELLM_URL/v1/chat/completions \
    -H "Authorization: Bearer $(envget LITELLM_MASTER_KEY)" -H "Content-Type: application/json" \
    -d '{"model":"'"$1"'","max_tokens":40,"messages":[{"role":"user","content":"Reply with one word: ready"}]}' || true
}
test_model() {
  local out model="${1:-colab-qwen}"
  out="$(llm "$model")"
  if echo "$out" | grep -q '"choices"'; then
    ok "Model reachable ($model): $(echo "$out" | python3 -c 'import sys,json;m=json.load(sys.stdin)["choices"][0]["message"];print((m.get("content") or "(thinking)").strip()[:60])')"
  else
    if [ "$model" = "colab-qwen" ]; then
      warn "Worker model not reachable at $(envget WORKER_API_BASE). Colab: is the notebook running, and did you run ./rvkit connect <url>? Other endpoints: ./rvkit worker"
    else
      warn "Model '$model' not reachable. Check OPENROUTER_API_KEY in .env and ./rvkit logs litellm"
    fi
    echo "$out" | head -c 400; echo
    return 1
  fi
}
worker_reachable() { # cheap check: does the worker endpoint answer /models? (no tokens spent)
  local base key; base="$(envget WORKER_API_BASE)"; key="$(envget WORKER_API_KEY)"
  base="${base/host.docker.internal/127.0.0.1}"
  curl -s -m 8 -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $key" "${base%/}/models" | grep -q '^2'
}

wait_openhands() {
  for _ in $(seq 1 60); do
    # through the gateway: a 502 means OpenHands itself isn't up yet
    [ "$(curl -s -o /dev/null -w '%{http_code}' $OPENHANDS_URL/openapi.json)" = 200 ] && return 0
    sleep 2
  done
  warn "OpenHands is not responding yet. Check with: ./rvkit logs agent-canvas (a database migration error there means the openhands-data volume was used by a newer OpenHands: set AGENT_CANVAS_TAG in .env to that version)"; return 1
}
config_openhands() { # $1 = --quiet or empty
  wait_openhands || return 1
  python3 scripts/openhands_config.py ${1:-} || { warn "OpenHands configuration failed (see above)"; return 1; }
}

start_stack() { # pulls the published images for this version; builds any that aren't published (or all of them
  # with RVKIT_BUILD=1, which you want after changing the kit's code)
  if [ -n "${RVKIT_BUILD:-}" ]; then docker compose up -d --build
  elif [ -n "${RVKIT_NO_PULL:-}" ]; then docker compose up -d   # images already built locally (CI)
  else
    docker compose pull --ignore-pull-failures -q >/dev/null 2>&1 || true
    docker compose up -d
  fi
}

open_url() { if command -v open >/dev/null; then open "$1"; elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1; fi; }

lab_dvwa_init() { # DVWA creates its tables from its setup page; run it once the database accepts connections
  local _
  for _ in $(seq 1 30); do
    if docker compose exec -T lab-dvwa-db mariadb -udvwa -pp@ssw0rd dvwa -e 'select 1 from users limit 1' >/dev/null 2>&1; then
      return 0
    fi
    docker compose exec -T lab-dvwa sh -c '
      c=/tmp/dvwa.cookies; t=$(curl -s -c $c -b $c http://localhost/setup.php | sed -n "s/.*user_token. value=.\([a-f0-9]*\).*/\1/p" | head -1)
      [ -n "$t" ] && curl -s -c $c -b $c -o /dev/null -d "create_db=Create+%2F+Reset+Database&user_token=$t" http://localhost/setup.php' \
      >/dev/null 2>&1 || true
    sleep 2
  done
  warn "DVWA database setup didn't complete: check ./rvkit logs lab-dvwa-db"
}

lab_vampi_init() { # VAmPI starts with an empty database: /createdb fills it with sample users and books
  local _
  for _ in $(seq 1 30); do
    docker compose exec -T lab-vampi python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/createdb', timeout=5)" \
      >/dev/null 2>&1 && return 0
    sleep 2
  done
  warn "VAmPI database setup didn't complete: check ./rvkit logs lab-vampi"
}
LAB="lab-juice-shop lab-dvwa lab-dvwa-db lab-vampi lab-dvga lab-llm"

# Who acts, for the audit log: cli:<login> here; the console sets RVKIT_ACTOR=console:<login> when it calls rvkit.
actor() { local a="${RVKIT_ACTOR:-cli:$(id -un 2>/dev/null | tr -cd 'A-Za-z0-9._@-' | cut -c1-64)}"
  case "$a" in cli:?*|console:?*) printf '%s' "$a" ;; *) printf 'cli:host' ;; esac; }
kctl() { docker compose exec -T kali-mcp python3 /opt/kali-mcp/rvctl.py --actor "$(actor)" "$@"; }
eng_dir() { printf '%s/%s' "$(expand "$(envget ENGAGEMENTS_DIR)")" "$1"; }

write_engagement() { # write_engagement <name> <client> <tiers> <rate> <network> <private:y|n> <target>...
  local name="$1" client="$2" tiers="$3" rate="$4" network="$5" private="$6" dir; shift 6
  dir="$(eng_dir "$name")"; mkdir -p "$dir/report"
  { echo "# Authorised scope ($(date +%F)). One host, domain, CIDR, or /src/<repo> path per line."
    echo "# *.example.com covers subdomains. Change it here, then run: ./rvkit scope $name"
    for t in "$@"; do echo "- $t"; done; } > "$dir/SCOPE.md"
  [ -f "$dir/RULES.md" ] || {
    echo "# Rules of engagement for $name. Change here, then run: ./rvkit scope $name"
    echo "- Allowed tiers: $tiers"
    echo "- Max rate: $rate"
    echo "- Network: $network"
    echo "# - Window (UTC): 08:00-18:00"
    echo "# - Strict tiers: on       (scripts and interpreters, and curl/wget sending data, count as intrusive)"
    if [ "$private" = y ]; then echo "- Worker model: private"
    else echo "# - Worker model: private      (never use the OpenRouter fallback model for this engagement's tool work)"; fi
    echo "# Tiers: passive (code review, DNS, research), active (scans, crawling), intrusive (exploitation, brute force;"
    echo "# each command needs ./rvkit approve). Network: offline = no package/vulnerability-database sites either."
  } > "$dir/RULES.md"
  if [ -n "$client" ]; then
    if [ -f "$dir/report/meta.txt" ]; then K=Client V="$client" perl -pi -e 's/^Client:.*/Client: $ENV{V}/' "$dir/report/meta.txt"
    else printf 'Client: %s\n' "$client" > "$dir/report/meta.txt"; fi
  fi
  kctl sync "$name" --yes
}

# ---------------------------------------------------------------- setup
cmd_setup() {
  local first=n data key worker
  case "${1:-}" in --yes|-y) export RVKIT_YES=1 ;; esac
  bold "1/5 Checking prerequisites"
  need_docker; ok "Docker running"
  local t; for t in openssl python3 curl perl; do command -v "$t" >/dev/null || die "$t is missing"; done
  ok "openssl, python3, curl, perl"

  bold "2/5 Settings (.env)"
  if [ -f .env ]; then ok ".env exists, keeping your settings (change them with ./rvkit commands or in .env)"
  else
    first=y
    cp .env.example .env
    envset LITELLM_MASTER_KEY "sk-rv-$(rand 16)"
    envset SEARXNG_SECRET "$(rand 32)"
    envset COLAB_API_KEY "rv-$(rand 20)"
    # shellcheck disable=SC2088 # the default is shown as typed; expand() resolves the ~
    data="$(ask "Folder for client code and engagements" "${RVKIT_DATA_DIR:-~/riskvoid}")"; data="$(expand "$data")"
    envset PROJECTS_DIR "$data/projects"
    envset ENGAGEMENTS_DIR "$data/engagements"
    local org; org="$(ask "Organisation name on reports (RiskVoid = RiskVoid-branded report)" "${RVKIT_ORG:-RiskVoid}")"
    if [ "$org" != "RiskVoid" ]; then envset ORG_NAME "$org"; envset REPORT_BRAND plain
      echo "   ${D}report brand: plain, with your name. Custom logo and colours: see harness/brands/example/README.md${N}"; fi
    key="$(ask_secret "OpenRouter API key for the planner (https://openrouter.ai/keys)")"
    [ -z "$key" ] || envset OPENROUTER_API_KEY "$key"
    ok "created .env with fresh secrets"
  fi
  need_env
  mkdir -p "$(expand "$(envget PROJECTS_DIR)")" "$(expand "$(envget ENGAGEMENTS_DIR)")"
  ok "client code: $(envget PROJECTS_DIR)   engagements: $(envget ENGAGEMENTS_DIR)"

  bold "3/5 Starting containers (first time: a few minutes with prebuilt images, ~10 min if building)"
  start_stack
  wait_litellm; ok "Stack is up"

  bold "4/5 Configuring OpenHands (LLM profiles, MCP servers, agent profiles)"
  config_openhands && ok "OpenHands ready"
  [ -n "$(envget "$(planner_key)")" ] || warn "No planner key: add $(planner_key) to .env (then ./rvkit up), or use the riskvoid-local agent (worker model only)"

  bold "5/5 Worker model (runs the tools and sees client code)"
  worker="later"
  if [ "$first" = y ]; then
    echo "   colab  Qwen3.8-27B on a Google Colab GPU (Colab Pro); started per session"
    echo "   local  a server on this machine: Ollama, LM Studio, llama-server, vLLM (detected automatically)"
    echo "   api    any OpenAI-compatible URL you run (RunPod, Modal, your GPU server)"
    echo "   openrouter  no GPU: a hosted model with your OpenRouter key (client data goes to OpenRouter)"
    echo "   later  decide later (./rvkit worker)"
    worker="$(ask "Worker" "${RVKIT_WORKER:-colab}")"
  fi
  case "$worker" in
    local) "$SELF" worker local || true ;;
    openrouter) "$SELF" worker openrouter || true ;;
    api)   local u m k; u="$(ask "Endpoint base URL (ending in /v1)" "")"; m="$(ask "Model name" "")"
           k="$(ask_secret "API key")"; [ -n "$u" ] && [ -n "$m" ] && "$SELF" worker api "$u" "$m" "${k:-none}" || true ;;
    colab) cat <<EOF
   Start it each session:
   • with Claude Code: run 'claude' in this folder and type /rv-start
   • by hand: open colab/rvkit_model_server.ipynb in Colab, paste this into its API_KEY field:
       $(envget COLAB_API_KEY)
     then Run all, and run the './rvkit connect …' line it prints.
EOF
    ;;
  esac
  echo
  ok "Done. Open ${B}$UI_URL${N} and talk to the ${B}riskvoid-planner${N} agent."
  echo "   First try, no client data: ./rvkit quickstart     Check everything: ./rvkit doctor"
}

# ---------------------------------------------------------------- doctor
# kit_exposed: true when the kit folder (.env, the console token) sits inside a folder the containers mount
kit_exposed() {
  python3 -c 'import os,sys; k=os.path.realpath(sys.argv[1]); sys.exit(0 if any(d and (k+"/").startswith(os.path.realpath(os.path.expanduser(d)).rstrip("/")+"/") for d in sys.argv[2:]) else 1)' \
    "$PWD" "$(envget PROJECTS_DIR)" "$(envget ENGAGEMENTS_DIR)"
}

cmd_doctor() {
  local fails=0 warns=0 v
  pass() { ok "$*"; }
  fail() { bad "$*"; fails=$((fails+1)); }
  note() { warn "$*"; warns=$((warns+1)); }
  bold "Host"
  command -v docker >/dev/null && docker info >/dev/null 2>&1 && pass "Docker running ($(docker version -f '{{.Server.Version}}' 2>/dev/null))" || fail "Docker not installed or not running"
  docker compose version >/dev/null 2>&1 && pass "Docker Compose $(docker compose version --short 2>/dev/null)" || fail "Docker Compose v2 missing"
  for v in openssl python3 curl perl; do command -v "$v" >/dev/null || fail "$v missing"; done
  v="$(docker info -f '{{.MemTotal}}' 2>/dev/null || echo 0)"; v=$((v / 1024 / 1024 / 1024))
  if [ "$v" -ge 14 ]; then pass "Docker memory: ${v} GB"; elif [ "$v" -ge 8 ]; then note "Docker memory: ${v} GB (16 GB recommended: Joern and ZAP are memory-hungry)"; else fail "Docker memory: ${v} GB (needs 8+, 16 recommended)"; fi
  pass "CPU architecture: $(docker info -f '{{.Architecture}}' 2>/dev/null)"
  [ -f .env ] || { fail "No .env: run ./rvkit setup"; bold "Result"; bad "$fails problem(s)"; exit 1; }
  local data; data="$(expand "$(envget ENGAGEMENTS_DIR)")"; mkdir -p "$data" 2>/dev/null || true
  v="$(df -Pk "$data" 2>/dev/null | awk 'NR==2 {print int($4/1024/1024)}')"
  [ "${v:-0}" -ge 25 ] && pass "Free disk: ${v} GB" || note "Free disk: ${v:-?} GB where engagements live (25 GB recommended for images and evidence)"

  bold "Settings"
  for v in PROJECTS_DIR ENGAGEMENTS_DIR; do [ -d "$(expand "$(envget $v)")" ] && pass "$v: $(envget $v)" || fail "$v folder missing: $(envget $v)"; done
  if kit_exposed; then fail "The kit folder is inside PROJECTS_DIR or ENGAGEMENTS_DIR: containers would see .env and the console token. Move it, or point those settings elsewhere"
  else pass "The kit folder (keys, console token) is not mounted into any container"; fi
  [ -n "$(envget "$(planner_key)")" ] && pass "$(planner_key) set (planner)" || note "$(planner_key) empty: only the riskvoid-local agent works"
  [ "$(envget WORKER_FALLBACK)" = on ] && note "Worker fallback ON: while the worker is down, tool output and code go to $(envget WORKER_FALLBACK_MODEL)" || pass "Worker fallback off"

  bold "Services"
  local want="agent-canvas gateway egress-proxy litellm redis searxng web-mcp kali-mcp worker-mcp findings-mcp intel-mcp" running
  running="$(docker compose ps --status running --services 2>/dev/null || true)"
  for v in $want; do echo "$running" | grep -qx "$v" && pass "$v running" || fail "$v not running (./rvkit up; ./rvkit logs $v)"; done
  if docker compose logs --tail 200 agent-canvas 2>/dev/null | grep -q "Can't locate revision"; then
    fail "OpenHands can't read its database (used by a newer OpenHands): set AGENT_CANVAS_TAG in .env to that version"; fi
  curl -s -o /dev/null $LITELLM_URL/health/liveliness && pass "LiteLLM answers" || fail "LiteLLM doesn't answer on 127.0.0.1:$LITELLM_PORT"
  [ "$(curl -s -o /dev/null -w '%{http_code}' $OPENHANDS_URL/openapi.json)" = 200 ] && pass "OpenHands answers ($UI_URL)" || fail "OpenHands doesn't answer through the gateway"
  if v="$(python3 scripts/openhands_config.py --check 2>&1)"; then pass "MCP servers: $v"; else fail "MCP servers: $v"; fi

  bold "Isolation"
  if docker compose exec -T kali-mcp nft list table inet rvkit >/dev/null 2>&1; then pass "Kali scope firewall loaded"; else fail "Kali scope firewall not loaded (./rvkit logs kali-mcp)"; fi
  if docker compose exec -T agent-canvas curl -s -m 8 -o /dev/null https://example.com/ 2>/dev/null; then
    fail "OpenHands container reached example.com: the egress lockdown is not working"
  else pass "OpenHands container has no open internet (egress proxy allowlist)"; fi
  if docker compose exec -T worker-mcp python3 -c 'import urllib.request as u; u.urlopen("https://example.com/", timeout=8)' >/dev/null 2>&1; then
    fail "Worker container reached example.com: it should be on the internal network only"
  else pass "Worker container has no internet (search and fetch go through web-mcp)"; fi

  bold "Models"
  if worker_reachable; then pass "Worker endpoint answers: $(envget WORKER_API_BASE) ($(envget WORKER_MODEL_ID))"
  else note "Worker endpoint not reachable: $(envget WORKER_API_BASE) (start Colab with /rv-start, or ./rvkit worker)"; fi
  if [ "${1:-}" = "--models" ]; then
    llm planner | grep -q '"choices"' && pass "Planner answers ($(envget PLANNER_MODEL))" || fail "Planner call failed (./rvkit test planner)"
  else echo "   ${D}planner not called (costs a fraction of a cent): ./rvkit doctor --models${N}"; fi
  if [ -n "$(python3 scripts/model_events.py --since 86400 --problems 2>/dev/null)" ]; then
    note "Model calls failed in the last 24 hours:"; python3 scripts/model_events.py --since 86400 --problems | head -5 | sed 's/^/   /'
  else pass "No failed model calls in the last 24 hours"; fi

  bold "Result"
  if [ "$fails" -eq 0 ]; then if [ "$warns" -gt 0 ]; then ok "No problems found ($warns warning(s))"; else ok "No problems found"; fi; else bad "$fails problem(s), $warns warning(s)"; exit 1; fi
}

# ---------------------------------------------------------------- status
# model problems logged by litellm/rv_events.py: model_problems <seconds> <label>
model_problems() {
  local p r
  p="$(python3 scripts/model_events.py --since "$1" --problems 2>/dev/null || true)"
  r="$(python3 scripts/model_events.py --since "$1" 2>/dev/null | grep -c 'recovered: ' || true)"
  if [ -n "$p" ]; then
    warn "Model problems $2 (newest first):"
    echo "$p" | head -5 | sed 's/^/   /'
    [ "$(echo "$p" | grep -c .)" -le 5 ] || echo "   ${D}... more in the console, or: python3 scripts/model_events.py --since $1${N}"
  else ok "No model problems $2"; fi
  [ "${r:-0}" -gt 0 ] && echo "   ${D}$r time(s) another model answered instead (refusal or error): python3 scripts/model_events.py --since $1${N}"
  return 0
}
cmd_status() {
  local all running list
  all="$(docker compose config --services 2>/dev/null | grep -v '^lab-' | sort)"
  running="$(docker compose ps --status running --services 2>/dev/null | sort)"
  local n_all n_run; n_all="$(echo "$all" | grep -c . || true)"; n_run="$(comm -12 <(echo "$all") <(echo "$running") | grep -c . || true)"
  if [ "$n_run" = "$n_all" ]; then ok "Stack: $n_run/$n_all services running   UI: $UI_URL"
  else warn "Stack: $n_run/$n_all services running; not running: $(comm -23 <(echo "$all") <(echo "$running") | tr '\n' ' ')(./rvkit up)"; fi
  echo "$running" | grep -q '^lab-' && echo "   lab: $(echo "$running" | grep -c '^lab-') target(s) up (./rvkit lab status)"
  if worker_reachable; then ok "Worker: $(envget WORKER_MODEL_ID) at $(envget WORKER_API_BASE)"
  else warn "Worker: not reachable at $(envget WORKER_API_BASE) (Colab: /rv-start; other: ./rvkit worker)"; fi
  [ "$(envget WORKER_FALLBACK)" = on ] && echo "   fallback ON: $(envget WORKER_FALLBACK_MODEL) (sees client data while the worker is down)" \
                                       || echo "   fallback off"
  if [ -n "$(envget "$(planner_key)")" ]; then ok "Planner: $(envget PLANNER_MODEL)"; else warn "Planner: no $(planner_key) in .env"; fi
  echo "   Model spend today: \$$(spend_sum) (daily budget \$$(envget OPENROUTER_DAILY_BUDGET) per provider)"
  model_problems 3600 "in the last hour"
  if list="$(kctl list --json 2>/dev/null)"; then
    echo "$list" | G="$G" Y="$Y" N="$N" python3 -c 'import sys,json
rows=json.load(sys.stdin); p=sum(r["pending"] for r in rows); h=sum(1 for r in rows if r["halted"])
import os; print((os.environ["Y"]+"!"+os.environ["N"] if p else os.environ["G"]+"✔"+os.environ["N"]) + " Engagements: %d%s; pending approvals: %d%s" % (len(rows), " (%d halted)" % h if h else "", p, "  → ./rvkit watch" if p else ""))'
  fi
}

# ---------------------------------------------------------------- approvals watch
notify() {
  if command -v osascript >/dev/null; then osascript -e "display notification \"$2\" with title \"$1\" sound name \"Glass\"" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null; then notify-send "$1" "$2" >/dev/null 2>&1 || true; fi
  printf '\a'
}
cmd_watch() {
  interactive || die "./rvkit watch needs a terminal (it asks you to approve or deny each command)"
  bold "Watching for intrusive commands that need approval, and for failed model calls (all engagements). Ctrl-C to stop."
  local seen=" " rows id eng tier command a mline mnew
  mline="$(python3 scripts/model_events.py --count 2>/dev/null || echo 0)"
  while true; do
    # model problems (litellm/rv_events.py): print and notify each new one; recovered ones are printed only
    mnew="$(python3 scripts/model_events.py --from-line "$mline" --json 2>/dev/null || echo '[]')"
    if [ "$mnew" != "[]" ]; then
      mline="$(python3 scripts/model_events.py --count 2>/dev/null || echo "$mline")"
      while IFS=$'\t' read -r a command; do
        [ -n "$command" ] || continue
        if [ "$a" = problem ]; then notify "RiskVoid: model call failed" "${command:0:120}"; warn "model: $command"
        else echo "   ${D}model (recovered): $command${N}"; fi
      done <<< "$(echo "$mnew" | python3 -c 'import sys,json
for e in json.load(sys.stdin): print(("problem" if e["problem"] else "info") + "\t" + e.get("message","").replace("\t"," "))')"
    fi
    rows="$(kctl approvals --json 2>/dev/null | python3 -c 'import sys,json
for r in json.load(sys.stdin): print("\t".join([r["id"], r["engagement"], r["tier"], r["command"].replace("\t"," ").replace("\n"," ")]))' 2>/dev/null || true)"
    while IFS=$'\t' read -r id eng tier command; do
      [ -n "$id" ] || continue
      case "$seen" in *" $id "*) continue ;; esac
      seen="$seen$id "
      notify "RiskVoid: approval needed" "$eng: ${command:0:80}"
      printf '\n%s%s%s  %s  [%s]\n  %s\n' "$B" "$eng" "$N" "$id" "$tier" "$command"
      a="$(ask "Approve this command? a=approve, d=deny, s=skip for now" "s")"
      case "$a" in
        a|A|y|Y) kctl approve "$eng" "$id" && ok "approved: tell the agent to run it again" ;;
        d|D|n|N) kctl deny "$eng" "$id" && ok "denied" ;;
        *) echo "   skipped (still pending: ./rvkit approve $eng $id)" ;;
      esac
    done <<< "$rows"
    sleep 3
  done
}

# ---------------------------------------------------------------- update
cmd_update() {
  need_env; need_docker
  { command -v git >/dev/null && [ -d .git ]; } || die "this kit isn't a git checkout: download the new release, copy your .env into it, then run ./rvkit up there"
  git diff --quiet && git diff --cached --quiet || die "tracked files have local changes (git status). Commit or stash them, then run ./rvkit update again"
  local before after new
  before="$(git rev-parse HEAD)"
  bold "Pulling the latest kit ($(git rev-parse --abbrev-ref HEAD))"
  git pull --ff-only || die "git pull failed (your branch has diverged?). Sort it out with git, then run ./rvkit update again"
  after="$(git rev-parse HEAD)"
  if [ "$before" = "$after" ]; then ok "Already up to date ($(cat VERSION))"
  else
    ok "Updated to $(cat VERSION): $(git rev-list --count "$before..$after") commit(s)"
    git log --oneline --no-decorate "$before..$after" | head -15 | sed 's/^/   /'
    new="$(git diff "$before" "$after" -- .env.example | grep -E '^\+#? ?[A-Z][A-Z0-9_]*=' | sed 's/^+//; s/^# \{0,1\}//' || true)"
    [ -z "$new" ] || { echo "   New optional settings (see .env.example and docs/configuration.md):"; echo "$new" | sed 's/^/     /'; }
  fi
  bold "Updating images and restarting"
  exec "$SELF" up   # the new rvkit: it migrates .env and pulls (or builds) this version's images
}

# ---------------------------------------------------------------- engagements
cmd_new() {
  need_env
  local name client tiers rate network private t targets=() repos
  name="${1:-}"; [ -n "$name" ] || name="$(ask "Engagement name (letters, digits, . _ -)" "")"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid engagement name: '$name'"
  [ ! -f "$(eng_dir "$name")/SCOPE.md" ] || die "engagement $name exists: edit its SCOPE.md / RULES.md and run ./rvkit scope $name"
  client="$(ask "Client name (shown on the report)" "")"
  repos="$(cd "$(expand "$(envget PROJECTS_DIR)")" 2>/dev/null && ls -d */ 2>/dev/null | sed 's|/$||; s|^|/src/|' | tr '\n' ' ')"
  echo "Targets: hosts, domains (*.example.com for subdomains), CIDRs, or client code as /src/<folder>."
  [ -z "$repos" ] || echo "   ${D}code folders found: $repos${N}"
  echo "   ${D}code goes in $(envget PROJECTS_DIR)/<folder>; one target per line, empty line to finish${N}"
  while true; do t="$(ask "  target" "")"; [ -n "$t" ] || break; targets+=("$t"); done
  [ "${#targets[@]}" -gt 0 ] || die "no targets given"
  while true; do tiers="$(ask "Allowed tiers: passive, active, intrusive (intrusive commands still need your approval)" "passive, active")"
    echo "$tiers" | grep -qE '^ *(passive|active|intrusive)( *, *(passive|active|intrusive))* *$' && break
    interactive || die "invalid tiers: $tiers"; warn "comma-separated list of passive, active, intrusive"; done
  while true; do rate="$(ask "Max requests/packets per second" "100")"
    [[ "$rate" =~ ^[0-9]+$ ]] && break; interactive || die "invalid rate: $rate"; warn "a whole number"; done
  while true; do network="$(ask "Network: online (package/vulnerability databases allowed) or offline" "online")"
    case "$network" in online|offline) break ;; esac; interactive || die "invalid network: $network"; warn "online or offline"; done
  private=n; yesno "Keep this client's tool output on the worker endpoint only (never the fallback model)?" n && private=y
  write_engagement "$name" "$client" "$tiers" "$rate" "$network" "$private" "${targets[@]}"
  ok "Engagement $name is active. Files: $(eng_dir "$name")"
  echo "   Next: open $UI_URL and tell the riskvoid-planner agent, for example:"
  echo "   ${D}Engagement \`$name\`: <what to test>. Follow the matching playbooks, then write the executive summary and generate the report.${N}"
  echo "   While it runs: ./rvkit watch (approvals)   ./rvkit audit $name   ./rvkit halt $name"
}

cmd_engagement() { # non-interactive: engagement <name> [options] <target>...
  need_env
  [ $# -ge 2 ] || die "usage: ./rvkit engagement <name> [--client \"Client\"] [--tiers passive,active] [--rate 100] [--network online|offline] [--private] [--replace] <target> [target ...]   e.g. acme app.acme.com '*.acme.io' 203.0.113.0/28 /src/acme-repo"
  local name="$1" client="" replace=n tiers="passive, active" rate=100 network=online private=n; shift
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid engagement name: '$name'"
  while :; do case "${1:-}" in
    --client) client="${2:-}"; shift 2 ;;
    --tiers) tiers="$(echo "${2:-}" | sed 's/ *, */, /g')"; shift 2
             echo "$tiers" | grep -qE '^(passive|active|intrusive)(, (passive|active|intrusive))*$' || die "invalid --tiers: comma-separated passive, active, intrusive" ;;
    --rate) rate="${2:-}"; shift 2; [[ "$rate" =~ ^[0-9]+$ ]] || die "invalid --rate: a whole number" ;;
    --network) network="${2:-}"; shift 2; case "$network" in online|offline) ;; *) die "invalid --network: online or offline" ;; esac ;;
    --private) private=y; shift ;;
    --replace) replace=y; shift ;;
    *) break ;;
  esac; done
  [ $# -ge 1 ] || die "no targets given"
  if [ -f "$(eng_dir "$name")/SCOPE.md" ] && [ "$replace" = n ]; then
    die "engagement $name exists. To change its scope, edit $(eng_dir "$name")/SCOPE.md and run ./rvkit scope $name (shows the diff first). To replace its whole scope with these targets: ./rvkit engagement $name --replace <targets>"
  fi
  write_engagement "$name" "$client" "$tiers" "$rate" "$network" "$private" "$@"
}

